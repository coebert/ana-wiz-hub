+/** Containment only: no clinical generation until the versioned source pipeline is ready. */
+export const SOURCE_UNAVAILABLE = "Current source material is not yet available for reliable AI answers or clinical scoring. Please read the relevant topic and original guidance. Your saved history has been kept.";
+export function sourceUnavailable(headers: HeadersInit = {}): Response {
+  return new Response(JSON.stringify({ status: "source_unavailable", code: "SOURCE_UNAVAILABLE", error: SOURCE_UNAVAILABLE, clinicalScore: null }), {
+    status: 503, headers: { ...Object.fromEntries(new Headers(headers)), "Content-Type": "application/json", "Cache-Control": "no-store" },
+  });
+}
