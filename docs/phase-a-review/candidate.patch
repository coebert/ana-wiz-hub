+++ b/src/lib/sourceUnavailable.ts
@@ -0,0 +1,19 @@
+import { supabase } from "@/integrations/supabase/client";
+export const SOURCE_UNAVAILABLE = "Current source material is not yet available for reliable AI answers or clinical scoring. Please read the relevant topic and original guidance. Your saved history has been kept.";
+/** A typed non-stream response is converted to the UI's normal error state. No SSE is fabricated. */
+export const sourceAwareFetch: typeof fetch = async (input, init) => {
+  const response = await fetch(input, init);
+  if (response.headers.get("Content-Type")?.includes("application/json")) {
+    const body = await response.clone().json().catch(() => null);
+    if (body?.code === "SOURCE_UNAVAILABLE") throw new Error(SOURCE_UNAVAILABLE);
+  }
+  return response;
+};
+export async function invokeViva(options: Parameters<typeof supabase.functions.invoke>[1]) {
+  const result = await supabase.functions.invoke("viva", options);
+  if (result.error?.context instanceof Response) {
+    const body = await result.error.context.clone().json().catch(() => null);
+    if (body?.code === "SOURCE_UNAVAILABLE") return { ...result, data: null, error: new Error(SOURCE_UNAVAILABLE) };
+  }
+  return result;
+}
