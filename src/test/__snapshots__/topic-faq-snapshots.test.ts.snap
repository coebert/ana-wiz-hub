      },
      {
        "@type": "Question",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Assume VT until proven otherwise — particularly with structural heart disease; treat with synchronised DC if unstable, amiodarone 300 mg IV if stable, avoid verapamil which can collapse VT into VF.",
        },
        "name": "How are wide-complex tachycardias approached when the diagnosis is uncertain?",
      },
    ],
  },
