    "dev": "vite",
    "predev": "tsx scripts/generate-sitemap.ts && npm run gen:diagram-snapshots",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "prebuild": "npm run check -- --rule=citation-stats && tsx scripts/generate-sitemap.ts && npm run gen:diagram-snapshots",
