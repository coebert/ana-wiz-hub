    "verify:claims": "node scripts/verify-claims.mjs",
    "verify:claims:extract": "node scripts/verify-claims.mjs --extract-only",
    "check": "node scripts/content-check.mjs",
    "check:all": "npm run check",
    "prepublish": "npm run check && npm run lint && npm run format:check && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:diagram-snapshots": "node scripts/generate-diagram-snapshot-registry.mjs",
    "test:diagram-snapshots": "npm run gen:diagram-snapshots && playwright test tests/visual/diagram-snapshots.spec.ts"
