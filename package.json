    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "optimize:heart": "node scripts/optimize-heart.mjs",
    "gen:citation-allowlist": "WRITE_CITATION_ALLOWLIST=1 vitest run src/__tests__/citation-coverage.test.ts",
